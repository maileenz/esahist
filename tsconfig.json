{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "checkJs": true,
    /* Bundled projects */
    "lib": ["dom", "dom.iterable", "ES2022"],
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    /* Path Aliases */
    /* No `baseUrl`: it is deprecated and stops working in TypeScript 7, and
       nothing here needs it. Since TypeScript 5.0 `paths` entries resolve
       against the directory holding this file, which is what `./src/*` below
       already assumes — `baseUrl` was only ever restating it. It would still be
       required if anything imported by a bare path (`import "src/lib/x"`);
       nothing does. */
    "paths": {
      "@/*": ["./src/*"],
      "@/colyseus/*": ["./src/server/colyseus/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.js",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "generated",
    /* The Colyseus process has its own tsconfig: its schema classes need
       `experimentalDecorators`, which this project deliberately does not set. */
    "src/server/colyseus"
  ]
}
