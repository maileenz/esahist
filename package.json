{
  "name": "grand-master",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n next,game -c red,orange --kill-others \"npm:dev:next\" \"npm:dev:game\"",
    "dev:next": "next dev --turbo",
    "dev:game": "tsx watch --tsconfig src/server/colyseus/tsconfig.json --clear-screen=false src/server/colyseus/index.ts",
    "build": "concurrently -n next,game -c cyan,magenta --kill-others-on-fail \"npm:build:next\" \"npm:build:game\"",
    "build:next": "next build",
    "build:game": "npm run typecheck:game && esbuild src/server/colyseus/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --tsconfig=src/server/colyseus/tsconfig.json --outfile=.game-build/server.mjs",
    "start": "concurrently -n next,game -c cyan,magenta --kill-others \"npm:start:next\" \"npm:start:game\"",
    "start:next": "next start",
    "start:game": "node .game-build/server.mjs",
    "lint": "biome check src scripts",
    "lint:fix": "biome check --write src scripts",
    "typecheck": "concurrently -n next,game -c cyan,magenta \"npm:typecheck:next\" \"npm:typecheck:game\"",
    "typecheck:next": "tsc -p tsconfig.json --noEmit",
    "typecheck:game": "tsc -p src/server/colyseus/tsconfig.json --noEmit",
    "test": "vitest run --config src/server/colyseus/vitest.config.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "check:messages": "tsx scripts/check-messages.ts",
    "gen:countries": "tsx scripts/generate-country-names.ts",
    "gen:icon": "tsx scripts/generate-icon.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@colyseus/core": "^0.17.50",
    "@colyseus/monitor": "^0.17.8",
    "@colyseus/playground": "^0.17.12",
    "@colyseus/schema": "^4.0.30",
    "@colyseus/sdk": "^0.17.43",
    "@colyseus/ws-transport": "^0.17.13",
    "@hookform/resolvers": "^5.9.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@uploadthing/react": "^7.3.3",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "colyseus": "^0.17.10",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "flag-icons": "^7.5.0",
    "glicko2.ts": "^1.3.2",
    "lucide-react": "^1.32.0",
    "mysql2": "^3.23.3",
    "next": "^16.3.1",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-chessboard": "^5.12.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "stripe": "^22.5.0",
    "superjson": "^2.2.6",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@colyseus/testing": "^0.17.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@auth/core": "0.41.2"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@10.11.0"
}
