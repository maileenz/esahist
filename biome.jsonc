{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"useIgnoreFile": true,
		"clientKind": "git"
	},
	"assist": {
		"enabled": true,
		"actions": {
			"recommended": true,
			"source": {
				"recommended": true,
				"organizeImports": "on",
				"useSortedAttributes": "on"
			}
		}
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"nursery": {
				"useSortedClasses": {
					"level": "warn",
					"fix": "safe",
					"options": {
						"functions": ["clsx", "cva", "cn"]
					}
				}
			}
		}
	},
	"html": {
		"formatter": {
			"enabled": true
		}
	},
	"javascript": {
		"assist": {
			"enabled": true
		},
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		}
	},
	"overrides": [
		{
			// Components and hooks are kebab-case: `user-list-item.tsx`,
			// `use-game-store.ts`. Enforced rather than remembered, so the
			// convention survives everybody who joins after it was agreed.
			"includes": ["src/components/**", "src/hooks/**"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": {
							"level": "error",
							"options": {
								"filenameCases": ["kebab-case"],
								"requireAscii": true
							}
						}
					}
				}
			}
		}
	,
		{
			// Vendored from the shadcn registry. It is regenerated by
			// `shadcn add`, so house rules it breaks are turned off here rather
			// than patched into files that a re-run would overwrite — and rather
			// than scattering suppression comments upstream would not keep.
			//
			// Both are deliberate upstream idioms in `input-group`: `role` on a
			// wrapper element, and a click handler on the padding around an input
			// that only forwards focus to the input itself.
			"includes": ["src/components/ui/**"],
			"linter": {
				"rules": {
					"a11y": {
						"useSemanticElements": "off",
						"useKeyWithClickEvents": "off"
					}
				}
			}
		}
	],
	"css": {
		"assist": {
			"enabled": true
		},
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		},
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	}
}
