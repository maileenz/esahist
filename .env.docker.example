# Configuration for the containers. Copy to `.env.docker` and fill in.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# `.env.docker` is git-ignored and never enters an image — the build context
# excludes it, and the containers read it at run time.

# ---------------------------------------------------------------- database
# Only the compose file uses these; the two app containers are handed a
# DATABASE_URL built from them, pointing at the `mysql` service rather than at
# localhost. Generate the passwords, do not type them:
#   openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=chess
MYSQL_USER=chess

# ------------------------------------------------------------------- hosts
# The two public hostnames. Caddy reads these to decide which certificates to
# get and where to send each request, so they are AUTH_URL and
# NEXT_PUBLIC_GAME_SERVER_URL below, minus the scheme.
SITE_DOMAIN=esahist.ro
GAME_DOMAIN=game.esahist.ro

# Where Let's Encrypt writes if a renewal ever stops working. Certificates renew
# silently for a year; this is how you find out when they do not.
#
# Required, and the proxy refuses to start without it. Caddy substitutes it into
# its own config, so an empty value is a syntax error rather than an omission.
ACME_EMAIL=you@example.com

# Ports published on the host, every one of them on loopback. The proxy does
# not use these — it reaches the containers by service name over the compose
# network — so they exist only to reach a container from the machine itself,
# for drizzle-kit or a mysqldump. Change one if the host already holds it.
WEB_HOST_PORT=3000
GAME_HOST_PORT=2567
MYSQL_HOST_PORT=3306

# ------------------------------------------------------------------- auth
# Where the app is served. Auth.js builds its callback URLs from this, so it
# must match what the browser sees, scheme included.
#
# It is also the site's canonical address: robots.txt, sitemap.xml, every
# canonical link and the social card's URL are built from it, and leaving it
# unset makes the deployment serve `Disallow: /` and `noindex` on purpose — so a
# staging copy cannot compete with the real domain in search.
AUTH_URL=https://esahist.ro

# openssl rand -base64 32
AUTH_SECRET=

# The shared parent domain, with the leading dot. This is what lets the session
# cookie reach the game server on a subdomain — without it the cookie is issued
# for esahist.ro alone, the game server never sees it, and every player joins as
# a guest. Leave unset only when both run on the same host.
AUTH_COOKIE_DOMAIN=.esahist.ro

# Redirect URIs are <AUTH_URL>/api/auth/callback/<provider>.
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# ------------------------------------------------------------ game server
# Where the *browser* reaches Colyseus. Inlined into the client bundle at build
# time, so changing it needs `--build`. Must be the app's domain or a subdomain
# of AUTH_COOKIE_DOMAIN, for the same cookie reason as above. wss:// is implied
# by https:// here — the SDK upgrades the scheme itself.
NEXT_PUBLIC_GAME_SERVER_URL=https://game.esahist.ro

# Which origins may open a cross-origin request to the game server. Comma
# separated. The app's own origin, and nothing else.
ALLOWED_ORIGINS=https://esahist.ro

# Never true in production. It skips the session lookup entirely and hands out
# guest identities, which turns an authentication failure into a silent "Guest
# 4" instead of a refusal — and those games cannot be saved, because a guest has
# no user row for the foreign key to point at.
ALLOW_ANONYMOUS=false

# The Colyseus dashboard at /monitor. Leave the password empty to not mount it
# at all; if you do mount it, put it behind the proxy rather than on the public
# internet, since it can inspect and dispose live rooms.
MONITOR_USER=admin
MONITOR_PASSWORD=

# ----------------------------------------------------------------- billing
# Optional. Without them the membership page says billing is not configured
# rather than failing. The webhook endpoint is <AUTH_URL>/api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=

# ----------------------------------------------------------------- uploads
# Optional. Without it, Settings → Profile hides the picture control.
UPLOADTHING_TOKEN=
