# One database for both processes. The game server reads Auth.js sessions from it.
DATABASE_URL=mysql://user:password@localhost:3306/chess

# Auth.js v5
AUTH_SECRET=run-`npx auth secret`-to-generate
# Also the site's canonical address — canonicals, robots.txt and sitemap.xml are
# built from it. Indexing is only ever enabled when this is set *and*
# NODE_ENV=production, so a local run is never indexable.
AUTH_URL=http://localhost:3000
# Sign-in providers. Redirect URIs are http://localhost:3000/api/auth/callback/<provider>.
# https://discord.com/developers/applications → OAuth2
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# https://github.com/settings/developers → OAuth Apps
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# https://developers.facebook.com/apps → Facebook Login → Settings
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
# https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client IDs.
# The authorised redirect URI must be listed exactly, including the port.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Production only: shared parent domain so the session cookie also reaches the
# game server on game.example.com. Leave unset locally (localhost ignores ports).
# AUTH_COOKIE_DOMAIN=.example.com

# Where the browser reaches the Colyseus process. In production this must be a
# subdomain of the app, or the session cookie will not be sent with it.
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:2567

# Colyseus process
GAME_PORT=2567
ALLOWED_ORIGINS=http://localhost:3000
# Skips session lookups entirely and hands out guest identities. Local only.
ALLOW_ANONYMOUS=false
# Set a password to mount the /monitor dashboard; leave empty to disable it.
MONITOR_USER=admin
MONITOR_PASSWORD=

# Stripe. Optional: leave unset and the membership page says billing is not
# configured rather than breaking the build.
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_51AbCdEf...
# The signing secret of the endpoint you registered, or the one `stripe listen`
# prints when forwarding to http://localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_AbCdEf...
# Membership is one recurring price; the app never sends an amount of its own.
# Dashboard -> Product catalogue -> your product -> its recurring price.
STRIPE_PRICE_MONTHLY=price_1AbCdEfGhIjKlMnO

# Avatar uploads. Dashboard -> your app -> API Keys.
# Without it, Settings -> Profile hides the picture control entirely.
UPLOADTHING_TOKEN=
